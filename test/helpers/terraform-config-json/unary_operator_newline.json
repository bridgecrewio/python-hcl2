{
  "variable": [
    {
      "names": {
        "type": [
          "${list(string)}"
        ],
        "default": [
          [
            "a"
          ]
        ],
        "validation": [
          {
            "condition": [
              "${alltrue([for n in var.names : length(n) > 0 && !contains(['host'],n) && n != \"x\"])}"
            ],
            "error_message": [
              "bad name"
            ]
          }
        ],
        "__start_line__": 1,
        "__end_line__": 13
      }
    }
  ],
  "locals": [
    {
      "not_then_or": [
        "${!var.a || var.b}"
      ],
      "negative_then_plus": [
        "${-var.c + 2}"
      ],
      "not_with_comment": [
        "${!var.a && var.b}"
      ],
      "__start_line__": 15,
      "__end_line__": 29
    }
  ]
}
